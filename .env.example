# ──────────────────────────────────────────────────────────────────
# paperdb env vars — alternative to config.toml (Docker / CI friendly)
# ──────────────────────────────────────────────────────────────────
# Real env vars ALWAYS win over config.toml values. Copy this file to
# `.env` and use a loader (direnv, docker-compose, systemd EnvironmentFile)
# — paperdb itself does NOT auto-load `.env`; that's by design so you
# can pick your own secret-management workflow.
#
# For interactive desktop use, prefer config.toml — see config.toml.example.
# ──────────────────────────────────────────────────────────────────

# ── Workspace location ──────────────────────────────────────────
# Where papers.db / pdfs/ / archive/ live. Wins over --workspace and
# auto-detection.
# PAPERDB_WORKSPACE=/data/paperdb

# ── LLM (chat / reasoning) ──────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-YOUR_KEY_HERE
# LLM_BASE_URL=https://api.deepseek.com/v1

LLM_COMPLEX_MODEL=deepseek-v4-pro
LLM_COMPLEX_THINKING=enabled
LLM_COMPLEX_REASONING_EFFORT=high
LLM_SIMPLE_MODEL=deepseek-v4-flash
LLM_SIMPLE_THINKING=disabled

# Per-stage tier override
# LLM_TIER_ANALYZE_PAPER=complex
# LLM_TIER_SCORE_REFS=simple
# LLM_TIER_LIT_REVIEW=complex
# LLM_TIER_RERANK=simple

# ── Embeddings (Qwen via DashScope International) ───────────────
LLM_EMBEDDING_MODEL=text-embedding-v4
LLM_EMBEDDING_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_EMBEDDING_API_KEY=sk-YOUR_DASHSCOPE_KEY_HERE
LLM_EMBEDDING_DIMENSIONS=1024
LLM_EMBEDDING_BATCH_SIZE=10

# ── Parsing backend ─────────────────────────────────────────────
# pymupdf (default) | mineru | auto
# PAPER_PARSE_BACKEND=auto

# ── Legacy / advanced overrides ─────────────────────────────────
# Individual path overrides (usually leave these alone and just set
# PAPERDB_WORKSPACE).
# PAPER_DB_PATH=/data/paperdb/papers.db
# PAPER_DB_PDF_DIR=/data/paperdb/pdfs
# PAPER_DB_ARCHIVE_DIR=/data/paperdb/archive
# PAPER_DB_VERBOSE=1
